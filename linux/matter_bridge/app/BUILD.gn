# pogo_matter_bridge: runs linux/matter_bridge/ingest's existing CoAP
# ingest server and a real connectedhomeip v1.6.0.0 Matter bridge in one
# process -- see chip/main.cpp's own top comment for the threading model,
# and docs/matter-bridge.md for the endpoint/cluster design this
# implements.
#
# Structurally mirrors examples/bridge-app/linux/BUILD.gn (same
# executable() shape, same core deps for the Linux platform's own
# commissioning/networking main loop) -- see this repo's own
# docs/matter-bridge.md for exactly what's shared with that example and
# what's this application's own code.
#
# //third_party/connectedhomeip and //third_party/pogo_repo (see this
# directory's own third_party/ -- the latter is a checked-in symlink to
# this repo's own root, fixed and portable; the former is created fresh by
# tools/build_matter_bridge.sh, pointed at $CHIP_ROOT, and is NOT checked
# in since CHIP_ROOT varies per machine) are how this GN project -- which
# lives OUTSIDE the connectedhomeip checkout, unlike every in-tree example
# -- reaches both the Matter SDK and this repo's own ingest/wire-format
# sources without vendoring either one.

import("//build_overrides/chip.gni")

import("${chip_root}/build/chip/tools.gni")

assert(chip_build_tools)

_pogo_repo = "//third_party/pogo_repo"
_ingest_dir = "${_pogo_repo}/linux/matter_bridge/ingest"

# The settings-sharing part of the API (see api/include/pogohome_api/
# settings_store.hpp, device_auth.hpp, tls_identity.hpp), shared by the
# bridge and the pogohome-hubctl operator tool.
_settings_sources = [
  "api/include/pogohome_api/atomic_file.hpp",
  "api/include/pogohome_api/crypto_util.hpp",
  "api/include/pogohome_api/device_auth.hpp",
  "api/include/pogohome_api/home_settings.hpp",
  "api/include/pogohome_api/json_value.hpp",
  "api/include/pogohome_api/settings_store.hpp",
  "api/include/pogohome_api/tls_identity.hpp",
  "api/src/atomic_file.cpp",
  "api/src/crypto_util.cpp",
  "api/src/device_auth.cpp",
  "api/src/home_settings.cpp",
  "api/src/json_value.cpp",
  "api/src/settings_store.cpp",
  "api/src/tls_identity.cpp",
]

# Shared by the bridge and the root-run pogohome-otbr-helper (see
# api/include/pogohome_api/otbr_helper_protocol.hpp): no OpenSSL, no Matter.
_otbr_helper_core_sources = [
  "api/include/pogohome_api/otbr_helper_protocol.hpp",
  "api/include/pogohome_api/subprocess.hpp",
  "api/src/otbr_helper_protocol.cpp",
  "api/src/subprocess.cpp",
]

executable("pogo_matter_bridge") {
  sources = _settings_sources
  sources += _otbr_helper_core_sources
  sources += [
    "api/include/pogohome_api/build_info.hpp",
    "api/include/pogohome_api/commissioner.hpp",
    "api/include/pogohome_api/enrollment.hpp",
    "api/include/pogohome_api/hex.hpp",
    "api/include/pogohome_api/http_server.hpp",
    "api/include/pogohome_api/hub_identity.hpp",
    "api/include/pogohome_api/interface_address.hpp",
    "api/include/pogohome_api/json_snapshot.hpp",
    "api/include/pogohome_api/mdns_advertiser.hpp",
    "api/include/pogohome_api/power_base_management.hpp",
    "api/include/pogohome_api/sensor_kind.hpp",
    "api/src/build_info.cpp",
    "api/src/commissioner.cpp",
    "api/src/enrollment.cpp",
    "api/src/power_base_management.cpp",
    "api/src/hex.cpp",
    "api/src/http_server.cpp",
    "api/src/hub_identity.cpp",
    "api/src/interface_address.cpp",
    "api/src/json_snapshot.cpp",
    "api/src/mdns_advertiser.cpp",
    "api/src/sensor_kind.cpp",
    "chip/chip_endpoint.cpp",
    "chip/chip_endpoint.hpp",
    "chip/main.cpp",
    "core/include/matter_bridge/bridge_manager.hpp",
    "core/include/matter_bridge/endpoint_store.hpp",
    "core/include/matter_bridge/uuid_hash.hpp",
    "core/include/matter_bridge/value_mapping.hpp",
    "core/src/bridge_manager.cpp",
    "core/src/endpoint_store.cpp",
    "core/src/value_mapping.cpp",

    # The REAL, unmodified ingest sources (see linux/matter_bridge/ingest's
    # own CMakeLists.txt, which already documents this "same sources, more
    # than one binary" pattern) -- this is a second, independent compile of
    # the exact same files ingest's own CMake build compiles, never a copy.
    "${_ingest_dir}/src/minicoap.cpp",
    "${_ingest_dir}/src/registry.cpp",
    "${_ingest_dir}/src/server.cpp",
    "${_ingest_dir}/src/session.cpp",

    # The REAL, unmodified production wire-format C sources (same
    # reuse pattern as linux/matter_bridge/ingest/CMakeLists.txt).
    "${_pogo_repo}/components/bridge_export_proto/bridge_export_proto.c",
    "${_pogo_repo}/components/pogo_proto/pogo_crc16.c",
    "${_pogo_repo}/components/sensor_channel/sensor_channel.c",

    # The Power Base management wire format (docs/power-base-management.md):
    # the same pure C file the firmware compiles.
    "${_pogo_repo}/components/power_base_mgmt/pb_mgmt_proto.c",
  ]

  include_dirs = [
    "api/include",

    # pogo_build_info_gen.h, written by tools/build_matter_bridge.sh before
    # `gn gen` (docs/versioning.md). Not checked in; without it
    # api/src/build_info.cpp reports "unknown".
    "api/generated",
    "core/include",
    "${_ingest_dir}/include",
    "${_pogo_repo}/components/bridge_export_proto/include",
    "${_pogo_repo}/components/pogo_proto/include",
    "${_pogo_repo}/components/power_base_mgmt/include",
    "${_pogo_repo}/components/sensor_channel/include",
    "${_pogo_repo}/components/topology_proto/include",
  ]

  deps = [
    "bridge-common",
    "${chip_root}/examples/platform/linux:app-main",
    "${chip_root}/src/app/clusters/air-quality-server",
    "${chip_root}/src/app/clusters/bridged-device-basic-information-server",
    "${chip_root}/src/app/clusters/concentration-measurement-server",
    "${chip_root}/src/app/clusters/identify-server",
    "${chip_root}/src/app/clusters/illuminance-measurement-server",
    "${chip_root}/src/app/clusters/relative-humidity-measurement-server",
    "${chip_root}/src/app/clusters/temperature-measurement-server",
    "${chip_root}/src/lib",
  ]

  cflags = [ "-Wall" ]

  # dlopen() of libavahi-client.so.3 for the Bonjour advertisement (see
  # api/include/pogohome_api/mdns_advertiser.hpp) -- no Avahi headers or
  # link-time dependency. libssl/libcrypto (OpenSSL) for the settings
  # API's TLS, pairing proofs and tokens: the same libssl-dev the
  # connectedhomeip Linux build already requires (tools/build_matter_bridge.sh).
  libs = [
    "dl",
    "ssl",
    "crypto",
  ]

  output_dir = root_out_dir
}

# Operator tool: pairing codes and device access (see
# api/tools/pogohome_hubctl.cpp). No Matter SDK code.
executable("pogohome-hubctl") {
  sources = _settings_sources
  sources += [
    "api/include/pogohome_api/build_info.hpp",
    "api/src/build_info.cpp",
    "api/tools/pogohome_hubctl.cpp",
  ]
  include_dirs = [
    "api/include",
    "api/generated",
  ]
  cflags = [ "-Wall" ]
  libs = [
    "ssl",
    "crypto",
  ]
  output_dir = root_out_dir
}

# Power Base enrollment's root-run OTBR helper (see
# api/tools/pogohome_otbr_helper.cpp): installed root-owned and allowed to
# the bridge's account by one exact sudoers rule. No OpenSSL, no Matter SDK.
executable("pogohome-otbr-helper") {
  sources = _otbr_helper_core_sources
  sources += [ "api/tools/pogohome_otbr_helper.cpp" ]
  include_dirs = [ "api/include" ]
  cflags = [ "-Wall" ]
  output_dir = root_out_dir
}

group("linux") {
  deps = [
    ":pogo_matter_bridge",
    ":pogohome-hubctl",
    ":pogohome-otbr-helper",
  ]
}

group("default") {
  deps = [
    ":pogo_matter_bridge",
    ":pogohome-hubctl",
    ":pogohome-otbr-helper",
  ]
}
