#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

#
# OpenThread -- the power base is the system's one and only ROOT/Leader (see
# docs/power-base.md). It reuses the exact same thread_manager component as
# `module` (thread_manager_start_as_root(): resume a commissioned dataset if
# one exists in NVS, otherwise form a new one from these same
# OPENTHREAD_NETWORK_* Kconfig defaults -- untouched here, same defaults the
# `openthread` component ships) -- FTD is required for a Leader/Router.
#
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n

#
# ESP System Settings
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

#
# Console: USB-Serial/JTAG, same reasoning as module/sdkconfig.defaults --
# the power base's serial console/flash/monitor transport is the chip's
# native USB-Serial/JTAG peripheral, kept consistent with `module` even
# though only ONE POGO UART is committed here (the other UART controller is
# free on this board, but is not used for a console to keep flash/monitor
# behavior identical across both projects).
#
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
