#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

#
# OpenThread -- lower module is a Minimal Thread Device (MTD), configured
# as a Sleepy End Device at runtime (see lower_thread.c). It never forms
# its own network: the Active Dataset always arrives over POGO UART.
#
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n

#
# ESP System Settings
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
