menu "POGO UART Protocol"

    config POGO_UART_PORT_NUM
        int "POGO UART port number"
        default 1
        help
            UART peripheral used for the POGO wired link (UART0 is normally
            reserved for the console/programming port).

    config POGO_UART_TX_GPIO
        int "POGO UART TX GPIO"
        default 10
        help
            Upper TX -> Lower RX. Chosen to avoid ESP32-H2 USB (GPIO26/27),
            boot strapping pins (GPIO8/9/25) and the SuperMini onboard LED
            (GPIO8/13). Change here if the real board wiring differs.

    config POGO_UART_RX_GPIO
        int "POGO UART RX GPIO"
        default 11
        help
            Upper RX <- Lower TX. See POGO_UART_TX_GPIO for pin selection notes.

    config POGO_UART_BAUD_RATE
        int "POGO UART baud rate"
        default 115200

    config POGO_UART_RX_BUF_SIZE
        int "POGO UART driver RX ring buffer size"
        default 512

    config POGO_UART_TX_BUF_SIZE
        int "POGO UART driver TX ring buffer size"
        default 512

    config POGO_PING_INTERVAL_MS
        int "Upper: docking-detection PING interval (ms)"
        default 1000
        help
            While no lower module has answered, the upper module sends a
            PING at this interval and treats a valid PONG as "docked".

    config POGO_ACK_TIMEOUT_MS
        int "Control message ACK/NACK timeout (ms)"
        default 300
        help
            Timeout for short request/response exchanges (identify, assign
            UUID, assign slot, dataset transfer). Separate from the Thread
            join timeout, which is much longer.

    config POGO_JOIN_TIMEOUT_MS
        int "Thread join timeout (ms)"
        default 20000
        help
            Maximum time the lower module waits after applying the Active
            Dataset for its Thread role to leave DETACHED before reporting
            join failure to the upper module.

    config POGO_MAX_RETRY
        int "Max retries per pairing step"
        default 3

    config POGO_ATTACH_SETTLE_MS
        int "AUTO mode: settle time after DETECT_IN debounces attached, before the first handshake (ms)"
        default 150
        help
            DETECT_IN can close a few ms before the UART/GND pogo contacts
            fully seat during a real dock motion. A bounded, explicit delay
            here (not a busy loop -- see pogo_port.c's PORT_STATE_ATTACH_SETTLE)
            gives those contacts time to settle before the first HELLO_REQ is
            sent, instead of racing a handshake against still-bouncing
            contacts. Cancelled immediately (falls back to WAIT_ATTACH) if
            DETECT_IN debounces back to detached during this window.

    config POGO_HOTSWAP_COOLDOWN_MS
        int "AUTO mode: cooldown before auto-retrying a transient handshake failure (ms)"
        default 3000
        help
            DOCK_TIMEOUT and LIVENESS_LOST are transient: if DETECT_IN still
            reads attached (no physical detach), a fresh handshake cycle
            starts automatically after this cooldown instead of requiring a
            new DETECT_IN edge -- covers a real dock where DETECT closes
            before UART/GND, so the first handshake cycle times out with no
            edge left to recover on. Cancelled immediately if DETECT_IN
            debounces to detached during the cooldown. Configuration/
            compatibility errors (PEER_TYPE_CONFLICT, PROTOCOL_VERSION_ERROR,
            CAPABILITY_MISMATCH) are NOT covered by this -- those still
            require a physical detach/reattach before retrying.

    config POGO_DETECT_RECONCILE_MS
        int "AUTO mode: DETECT_IN direct-read reconciliation interval (ms)"
        default 500
        help
            Backstop against a missed GPIO ISR or a full detect_queue
            (dropped edges, see pogo_port.c's detect_isr_drops counter): at
            this interval, the port task directly re-reads DETECT_IN's raw
            level and, if it disagrees with the level this port's debounce
            state currently believes, injects a synthetic edge so the normal
            debounce/commit path resynchronizes -- rather than staying
            wedged on a stale committed level until some unrelated later
            edge happens to correct it.

endmenu
