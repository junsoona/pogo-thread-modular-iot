#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

#
# OpenThread -- module always builds FTD exactly once (section 8 of the
# implementation spec). Which of ROOT/INTERMEDIATE/LEAF applies at runtime
# is entirely decided by role_manager + thread_manager, never by a
# compile-time choice; a LEAF is simply an FTD build configured at runtime
# with router_eligible=false and rx-on-when-idle=false (see thread_manager.c).
#
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n

#
# ESP System Settings
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

#
# Console: USB-Serial/JTAG ONLY (section 1 of the follow-up hardware
# bring-up spec). ESP32-H2 has exactly two UART controllers, and both are
# now committed to the two POGO ports (UPSTREAM=UART0, DOWNSTREAM=UART1 --
# see module_config/configs/*.json and docs/pogo-interface.md) -- there is no
# UART left over for a log console. The chip's native USB-Serial/JTAG
# peripheral (GPIO26/27, untouched by any POGO/sensor config -- see
# module_config's ESP32-H2 GPIO profile) is flash/monitor's actual transport
# either way, so redirecting ESP_LOG/printf there too costs nothing and
# frees UART0 entirely.
#
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
